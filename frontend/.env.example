# Revyu server configuration. Copy to .env.local for local dev; set the same
# names in Vercel (Project → Settings → Environment Variables) for production.
# Any ENVIRONMENT other than "local" refuses to start with default secrets or
# missing provider keys (src/server/env.ts). A deployment that leaves
# ENVIRONMENT unset is treated as "production".

# local | staging | production
ENVIRONMENT=local
# Rate limits persist in Postgres; honoured only when ENVIRONMENT=local (e2e runs).
DISABLE_RATE_LIMITS=true

# Supabase Postgres. The app uses the TRANSACTION pooler (port 6543) when set;
# DATABASE_URL (session pooler, port 5432) is the fallback and what Alembic uses.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Public https origins (production rejects localhost). PUBLIC_FLOW_BASE_URL is
# printed into QR codes, so it must never change once QRs are printed.
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_FLOW_BASE_URL=http://localhost:3000

# Random 32+ character values in production (openssl rand -hex 32).
ADMIN_SESSION_SECRET=change-me
AUTH_SECRET=change-me
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=

# Email: a Resend API key, or an SMTP login. With neither, mail is only logged (local).
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@revyu.in
# New Growth Service requests and print-kit orders are emailed here.
ADMIN_NOTIFY_EMAIL=

# Google Places (signup search, gap report, weekly rating poll). Local dev uses fake data when empty.
GOOGLE_PLACES_API_KEY=

# Razorpay. Leave empty locally to use the mock provider.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids created once in the Razorpay dashboard.
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_ANNUAL=

# Supabase Storage for owner uploads (logos, menu photos). Server-only key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
