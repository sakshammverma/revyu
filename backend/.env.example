# Copy to .env and fill in for local development.
# See documents/04-ARCHITECTURE.md and documents/05-DATA-MODEL.md.

DATABASE_URL=postgresql+psycopg://revyu:revyu@localhost:5432/revyu
ENVIRONMENT=local

# Google Places API (place lookup, review URL validation, weekly poll)
GOOGLE_PLACES_API_KEY=

# Razorpay (billing) — test mode keys in local/staging
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids created once in the Razorpay dashboard: monthly (period monthly,
# ₹499) and annual (period yearly, ₹4,499). Without keys, ENVIRONMENT=local
# uses a simulated checkout so signup can still be tested end to end.
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_ANNUAL=

# Transactional email (owner OTP, notifications)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@revyu.in

# Admin console auth
ADMIN_SESSION_SECRET=change-me

# Session/JWT signing for owner auth
AUTH_SECRET=change-me

# Public URLs
# Absolute base for magic-login links in owner emails
FRONTEND_BASE_URL=http://localhost:3000
# Origin encoded into printed QR codes (/r/{slug}) — the real domain in production
PUBLIC_FLOW_BASE_URL=http://localhost:3000
# Comma-separated; browser calls normally go same-origin via the Next.js /api rewrite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
